{
  "version": 1,
  "daemon": {
    "listen": "127.0.0.1:6767",
    "mcp": {
      "injectIntoAgents": true,
      "injectIntoProviders": [
        "pi-supervisor",
        "pi-lead",
        "pi-peer"
      ]
    },
    "browserTools": {
      "enabled": false
    },
    "autoArchiveAfterMerge": false,
    "enableTerminalAgentHooks": false,
    "appendSystemPrompt": "",
    "terminalProfiles": [
      {
        "id": "pi",
        "name": "Pi",
        "command": "pi",
        "args": [
          "{{{prompt}}}"
        ],
        "icon": "pi"
      },
      {
        "id": "claude",
        "name": "Claude Code",
        "command": "claude",
        "args": [
          "{{{prompt}}}"
        ],
        "icon": "claude"
      },
      {
        "id": "codex",
        "name": "Codex",
        "command": "codex",
        "args": [
          "{{{prompt}}}"
        ],
        "icon": "codex"
      },
      {
        "id": "opencode",
        "name": "OpenCode",
        "command": "opencode",
        "args": [
          "--prompt={{{prompt}}}"
        ],
        "icon": "opencode"
      }
    ],
    "agentProfiles": [
      {
        "id": "legacy_favorite:opencode:new-api%2Fplanner",
        "name": "new-api/planner",
        "provider": "opencode",
        "model": "new-api/planner"
      },
      {
        "id": "legacy_favorite:opencode:new-api%2Fcoder",
        "name": "new-api/coder",
        "provider": "opencode",
        "model": "new-api/coder"
      }
    ],
    "cors": {
      "allowedOrigins": [
        "https://app.paseo.sh"
      ]
    },
    "relay": {
      "enabled": true
    }
  },
  "app": {
