{
  "version": 1,
  "daemon": {
    "listen": "127.0.0.1:6767",
    "mcp": {
      "injectIntoAgents": true,
      "injectIntoProviders": ["pi-supervisor", "pi-lead", "pi-peer"]
    },
    "autoArchiveAfterMerge": false,
    "enableTerminalAgentHooks": false,
    "appendSystemPrompt": "",
    "cors": {
      "allowedOrigins": ["https://app.paseo.sh"]
    },
    "relay": {
      "enabled": true
    }
  },
  "app": {
    "baseUrl": "https://app.paseo.sh"
  },
  "agents": {
    "providers": {
      "pi": {
        "enabled": true
      },
      "pi-supervisor": {
        "extends": "pi",
        "label": "Pi Supervisor",
        "env": {
          "PASEO_PI_ROLE": "supervisor"
        },
        "models": [
          {
            "id": "new-api/coder",
            "label": "DeepSeek V4 Flash",
            "isDefault": true,
            "thinkingOptions": [
              {
                "id": "high",
                "label": "High"
              },
              {
                "id": "max",
                "label": "Max",
                "isDefault": true
              }
            ]
          },
          {
            "id": "new-api/planner",
            "label": "GPT-5.6 Luna",
            "isDefault": true,
            "thinkingOptions": [
              {
                "id": "low",
                "label": "Low"
              },
              {
                "id": "medium",
                "label": "Medium"
              },
              {
                "id": "high",
                "label": "High"
              },
              {
                "id": "xhigh",
                "label": "XHigh"
              },
              {
                "id": "max",
                "label": "Max",
                "isDefault": true
              }
            ]
          }
        ]
      },
      "pi-lead": {
        "extends": "pi",
        "label": "Pi Lead",
        "env": {
          "PASEO_PI_ROLE": "lead"
        },
        "models": [
          {
            "id": "new-api/coder",
            "label": "DeepSeek V4 Flash",
            "isDefault": true,
            "thinkingOptions": [
              {
                "id": "high",
                "label": "High"
              },
              {
                "id": "max",
                "label": "Max",
                "isDefault": true
              }
            ]
          },
          {
            "id": "new-api/planner",
            "label": "GPT-5.6 Luna",
            "isDefault": true,
            "thinkingOptions": [
              {
                "id": "low",
                "label": "Low"
              },
              {
                "id": "medium",
                "label": "Medium"
              },
              {
                "id": "high",
                "label": "High"
              },
              {
                "id": "xhigh",
                "label": "XHigh"
              },
              {
                "id": "max",
                "label": "Max",
                "isDefault": true
              }
            ]
          }
        ]
      },
      "pi-peer": {
        "extends": "pi",
        "label": "Pi Peer",
        "env": {
          "PASEO_PI_ROLE": "peer"
        },
        "models": [
          {
            "id": "new-api/coder",
            "label": "DeepSeek V4 Flash",
            "isDefault": true,
            "thinkingOptions": [
              {
                "id": "high",
                "label": "High",
                "isDefault": true
              },
              {
                "id": "max",
                "label": "Max"
              }
            ]
          },
          {
            "id": "new-api/planner",
            "label": "GPT-5.6 Luna",
            "thinkingOptions": [
              {
                "id": "low",
                "label": "Low",
                "isDefault": true
              },
              {
                "id": "medium",
                "label": "Medium"
              },
              {
                "id": "high",
                "label": "High"
              },
              {
                "id": "xhigh",
                "label": "XHigh"
              },
              {
                "id": "max",
                "label": "Max"
              }
            ]
          }
        ]
      },
      "copilot": {
        "enabled": false
      },
      "codex": {
        "enabled": false
      },
      "claude": {
        "enabled": false
      }
    }
  },
  "features": {
    "dictation": {
      "enabled": false
    },
    "voiceMode": {
      "enabled": false
    }
  }
